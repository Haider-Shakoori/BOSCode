{
  "name": "boscode",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "BOSCode — AI coding agent by BusinessOS",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
