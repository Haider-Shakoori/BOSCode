{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BOSCode",
  "version": "1.0.0",
  "identifier": "af.businessos.boscode",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BOSCode",
        "width": 1480,
        "height": 900,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "shortDescription": "AI Coding Agent by BusinessOS",
    "longDescription": "BOSCode is a local-first AI coding agent for understanding, editing, building, testing and shipping software.",
    "createUpdaterArtifacts": false,
    "publisher": "BusinessOS",
    "copyright": "Copyright © 2026 BusinessOS",
    "category": "DeveloperTool",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "BOSCODE_UPDATER_PUBKEY",
      "endpoints": [
        "https://github.com/Haider-Shakoori/BOSCode/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "allowDowngrades": false
    }
  }
}
