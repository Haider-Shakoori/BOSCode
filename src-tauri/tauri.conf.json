{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BOSCode",
  "version": "0.1.0",
  "identifier": "af.businessos.boscode",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BOSCode",
        "width": 1480,
        "height": 900,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "AI Coding Agent by BusinessOS",
    "longDescription": "BOSCode is a local-first AI coding agent for understanding, editing, building, testing and shipping software."
  }
}
